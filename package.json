    "autoprefixer": "^10.5.2",
    "eslint": "^9.19.0",
    "eslint-config-next": "^15.5.20",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "wrangler": "^4.107.0"
  },
  "overrides": {
    "postcss": "^8.5.16"
